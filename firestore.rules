rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow create: if ownsUserDoc(userId)
        && request.resource.data.uid == request.auth.uid;
      allow read, update: if ownsUserDoc(userId);
      allow delete: if false;
    }

    match /patients/{patientId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    match /doctors/{doctorId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    match /insuranceRecords/{recordId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    match /billingRecords/{recordId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    match /appointments/{appointmentId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    match /clinicalNotes/{noteId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    match /messages/{messageId} {
      allow read, create, update: if signedIn();
      allow delete: if false;
    }

    match /auditLogs/{auditLogId} {
      allow read, create: if signedIn();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
